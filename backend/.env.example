# Copy this file to .env and fill in the values. Never commit .env.

# Where Postgres lives. The default works with Homebrew Postgres on a Mac.
DATABASE_URL=postgresql+psycopg://localhost/mock_hackathon

# Secret used to hash phone numbers (MOC-15). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never change it once real data exists, or returning visitors stop matching.
PHONE_HMAC_KEY=

# Optional. When set, every endpoint except /api/health requires the header
# "Authorization: Bearer <this value>". Leave empty for local development.
API_TOKEN=

# Dedup scoring for no-phone visits (MOC-16). A match scoring at or above the
# merge threshold joins the household; at or above the review threshold it
# waits for a person to decide; below that it becomes a new household.
DEDUP_MERGE_THRESHOLD=0.90
DEDUP_REVIEW_THRESHOLD=0.70

# Comma-separated frontend origins allowed to call the API (Vite dev, Vite preview).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
